# --- Servidor ---
NODE_ENV=development
# Render inyecta PORT automáticamente.
PORT=3000
# Orígenes permitidos, separados por comas (sin barra final).
CORS_ORIGIN=http://localhost:4200

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=devcrm_user
DB_PASSWORD=devcrm_password
DB_NAME=devcrm_db
# El esquema se gestiona con migraciones TypeORM. Dejar en false.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
# Postgres gestionados (Neon, Render) requieren TLS: true en producción.
DB_SSL=false

# --- Autenticación ---
JWT_SECRET=cambia_este_secreto_en_produccion
# Duración del token en segundos (604800 = 7 días)
JWT_EXPIRES_IN=604800

# --- Piloto Pro ---
# Configurar juntos cuando se habilite el checkout externo.
BILLING_CHECKOUT_URL=
# Importe y moneda, tal como aparecen en el checkout. Ejemplo: "ARS 12.000"
BILLING_CHECKOUT_PRICE=

# Checkout de prueba de Mercado Pago. Usar una cuenta compradora de prueba.
MP_TEST_ACCESS_TOKEN=
MP_TEST_PAYER_EMAIL=
MP_TEST_MONTHLY_ARS=
MP_TEST_BACK_URL=
# Clave secreta del panel Webhooks de la aplicación del vendedor.
MP_WEBHOOK_SECRET=
# User ID del vendedor que identifica el token anterior. No es el App ID.
MP_WEBHOOK_COLLECTOR_ID=

# --- Desarrollo ---
# Habilita POST/DELETE /api/dev/seed (usuario demo). Nunca se activa en producción.
TEST_SEED_ENABLED=false

# Pago único de Pro: habilitar solo en pruebas con las cuentas MP_TEST_* anteriores.
# Reutiliza MP_TEST_MONTHLY_ARS como importe de UN MES (no crea recurrencias).
# MP_TEST_BACK_URL debe terminar en /plan. Requiere firma y vendedor configurados.
MP_ONE_TIME_ENABLED=false

# Todas las funciones gratis. Membresías deshabilitadas.
BILLING_MEMBERSHIPS_ENABLED=false

# Correo público de soporte. No habilita por sí solo el formulario.
SUPPORT_EMAIL=veloracrm.support@gmail.com
# Enlace independiente de donación de Mercado Pago. No concede funciones ni Pro.
DONATIONS_ENABLED=false
DONATION_CHECKOUT_URL=
# Ensayo de donación mediante SDK, solo para la cuenta MP_TEST_PAYER_EMAIL.
DONATIONS_TEST_ENABLED=false

# Habilitar solo después de preparar la recepción y atención de las consultas.
CONTACT_FORM_ENABLED=false

# Correo HTTPS (Render gratuito bloquea SMTP). Clave privada de Resend.
RESEND_API_KEY=
# Remitente autorizado en Resend. onboarding@resend.dev solo para pruebas a tu propia cuenta.
CONTACT_MAIL_FROM=
