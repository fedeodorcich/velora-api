# --- Servidor ---
NODE_ENV=development
# Render inyecta PORT automáticamente.
PORT=3000
# Orígenes permitidos, separados por comas (sin barra final).
CORS_ORIGIN=http://localhost:4200

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=devcrm_user
DB_PASSWORD=devcrm_password
DB_NAME=devcrm_db
# El esquema se gestiona con migraciones TypeORM. Dejar en false.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
# Postgres gestionados (Neon, Render) requieren TLS: true en producción.
DB_SSL=false

# --- Autenticación ---
JWT_SECRET=cambia_este_secreto_en_produccion
# Duración del token en segundos (604800 = 7 días)
JWT_EXPIRES_IN=604800

# --- Piloto Pro ---
# Configurar juntos cuando se habilite el checkout externo.
BILLING_CHECKOUT_URL=
# Importe y moneda, tal como aparecen en el checkout. Ejemplo: "ARS 12.000"
BILLING_CHECKOUT_PRICE=

# --- Desarrollo ---
# Habilita POST/DELETE /api/dev/seed (usuario demo). Nunca se activa en producción.
TEST_SEED_ENABLED=false
